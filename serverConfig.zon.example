// Cubyz Dedicated Server Configuration
// This file is automatically generated on first run.
// Edit these values to customize your server.

.{
    // Basic Settings
    .port = 47649,                          // Server port
    .maxPlayers = 32,                       // Maximum number of players
    .serverName = "Cubyz Dedicated Server", // Server name displayed in server list
    .motd = "Welcome to Cubyz!",            // Message of the day
    
    // Game Settings
    .whitelistEnabled = false,              // Enable whitelist
    .pvpEnabled = true,                     // Enable PvP combat
    .difficulty = 2,                        // 0=peaceful, 1=easy, 2=normal, 3=hard
    .seed = null,                           // World seed (null for random)
    .defaultGamemode = 0,                   // 0=survival, 1=creative, 2=adventure, 3=spectator
    
    // Performance Settings
    .renderDistance = 8,                    // Render distance for players
    .simulationDistance = 4,                // Simulation distance
    .tickRate = 20,                         // Ticks per second
    
    // World Settings
    .autoSaveInterval = 45,                 // Auto-save interval in seconds
    .spawnProtectionRadius = 16,            // Spawn protection radius in blocks
    
    // Network Settings
    .bindAddress = "",                      // IP to bind to (empty = all interfaces)
    .debugLogging = false,                  // Enable debug logging
    
    // RCON Settings (Remote Administration)
    .rconPassword = null,                   // RCON password (null to disable)
    .rconPort = null,                       // RCON port (null = port + 1)
    
    // Directory Settings
    .worldDirectory = "world",              // World data directory
    .playersDirectory = "players",          // Player data directory
    .logsDirectory = "logs",                // Logs directory
}
