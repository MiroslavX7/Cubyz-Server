// Cubyz Server Configuration File
// Copy this file to serverConfig.zon and edit the values as needed.
// Lines starting with // are comments.

// Network Settings
port = 47649
bindAddress = ""  // Empty means bind to all interfaces

// Server Information
serverName = "Cubyz Dedicated Server"
motd = "Welcome to Cubyz!"

// Game Settings
maxPlayers = 32
pvpEnabled = true
difficulty = 2  // 0=peaceful, 1=easy, 2=normal, 3=hard
defaultGamemode = 0  // 0=survival, 1=creative, 2=adventure, 3=spectator
seed = null  // null for random seed, or specify a number

// Performance Settings
renderDistance = 8
simulationDistance = 4
tickRate = 20  // Ticks per second

// World Settings
autoSaveInterval = 45  // Seconds between auto-saves
spawnProtectionRadius = 16

// Directories
worldDirectory = "world"
playersDirectory = "players"
logsDirectory = "logs"

// Advanced Settings
debugLogging = false
rconPassword = null  // Set a password for RCON remote administration
rconPort = null  // null means port + 1
